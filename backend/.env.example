# ==============================================================================
# ORION v2 — Online Pretrained Model API Configuration Example
# ==============================================================================

# 1. Google Gemini Flash (Primary Cloud Semantic Observer)
# Model Checkpoint: gemini-1.5-flash / gemini-2.0-flash
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Hugging Face Online Inference API Token
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# 3. OpenRouter / Alibaba Qwen API (Cloud Semantic Observer)
OPENROUTER_API_KEY=
QWEN_API_KEY=

# 4. Local Ollama Host (Optional local SLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
